# Copy to .env (untracked) and fill in real values.
# docker-compose.yml loads .env automatically.

# Shared password required to sign in to the app. Required — the server
# refuses to start without it.
APP_PASSWORD=change-me

# Random string used to sign session cookies. Required — the server refuses
# to start without it. Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Origins allowed to call the API via CORS (comma-separated). Defaults to
# the production domain if unset.
# ALLOWED_ORIGINS=https://pressurecheck.duckdns.org
